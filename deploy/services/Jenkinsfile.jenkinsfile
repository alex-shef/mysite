#!/usr/bin/env groovy
def new_build = true
pipeline {
    agent none
    options {buildDiscarder logRotator(numToKeepStr: '10')
            preserveStashes()
    }
    stages {
        stage('Tests') {
            agent {
                kubernetes {
                    inheritFrom 'backend-tests'
                }
            }
            stages {
                stage('Check Commit Changes') {
                    steps {
                        script {
                            def changedFiles = sh(script: 'git diff --name-only HEAD^ HEAD',
                                                    returnStdout: true).trim().split('\n')
                            echo "Changed files: ${changedFiles}"
                            def shouldBuild = changedFiles.any { !it.startsWith('deploy') }
                            echo "shouldBuild: ${shouldBuild}"
                            if (shouldBuild) {
                                echo 'Proceeding with build.'
                            } else {
                                echo 'Commit was made to "deploy" dir. Skipping build.'
                                new_build = false
                            }
                        }
                    }
                }
                stage('Linting') {
                    when {
                        expression {return new_build}
                    }
                    steps {
                        container('backend-tests') {
                                sh 'flake8 .'
                        }
                    }
                }

                stage('Backend Tests') {
                    when {
                        expression {return new_build}
                    }
                    environment {
                        POSTGRES_HOST = 'postgresql'
                        POSTGRES_PORT = 5432
                        POSTGRES_DB = 'myblog'
                        DJANGO_SETTINGS_MODULE = 'mysite.settings.prod'
                    }
                    steps {
                        container('backend-tests') {
                            withCredentials([usernamePassword(credentialsId: 'jenkins-database-usr-psw',
                                        passwordVariable: 'POSTGRES_PASSWORD', usernameVariable: 'POSTGRES_USER'),
                                        string(credentialsId: 'jenkins-django-secretkey', variable: 'SECRET_KEY')]) {
                                sh 'python3 manage.py test blog/tests'
                                stash name: 'source', useDefaultExcludes: false
                            }
                        }
                    }
                }
            }
        }

        stage('Build, Push, Deploy App') {
            when {
                beforeAgent true
                expression {return new_build}
            }
            agent {
                kubernetes {
                    inheritFrom 'app-builder'
                }
            }
            options { skipDefaultCheckout() }
            environment {
                APP_IMAGE = "ghcr.io/alex-shef/django-app"
                IMAGE_TAG = "v3.7.1"
            }
            stages {
                stage('Build') {
                    steps {
                        unstash 'source'
                        container('app-builder') {
                            sh 'podman build -t $APP_IMAGE:$IMAGE_TAG -f deploy/app/app.Dockerfile .'
                        }
                    }
                }

                stage('Push') {
                    environment {
                        GITHUB_CRD = credentials('jenkins-github-usr-psw')
                    }
                    options { retry(3) }
                    steps {
                        container('app-builder') {
                            sh 'echo $GITHUB_CRD_PSW | podman login ghcr.io -u $GITHUB_CRD_USR --password-stdin'
                            sh 'podman push $APP_IMAGE:$IMAGE_TAG'
                            sh 'podman tag $APP_IMAGE:$IMAGE_TAG $APP_IMAGE:latest'
                            sh 'podman push $APP_IMAGE:latest'
                        }
                    }
                }

                stage('Update Deployment File') {
                    environment {
                        GIT_REPO_NAME = "mysite"
                        GITHUB_CRD = credentials('jenkins-github-usr-psw')
                    }
                    steps {
                        unstash 'source'
                        sh '''
                        git config user.email "alexei.shef@gmail.com"
                        git config user.name "jenkins"
                        sed -i "s/v[0-9]*\\.[0-9]*\\.[0-9]*\\b/$IMAGE_TAG/g" deploy/app/app-deploy.yaml
                        git add deploy/app/app-deploy.yaml
                        git commit -m "Update deployment image to version $IMAGE_TAG"
                        git push https://$GITHUB_CRD_USR:$GITHUB_CRD_PSW@github.com/$GITHUB_CRD_USR/$GIT_REPO_NAME.git \
                            HEAD:deploy
                        '''
                    }
                }
            }
        }
    }
}
